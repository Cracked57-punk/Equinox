# ---------------------------------------------------------------------------
# Copy this file to .env and fill in real values. Never commit .env itself.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (Neon or Supabase — Round2.md §10)
# Get this from your provider's dashboard after creating a free-tier project.
DATABASE_URL="postgresql://user:password@host:6543/equinox?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/equinox?sslmode=require"

# Secret used to sign magic-link tokens and admin session cookies.
# Generate one with: openssl rand -base64 32
# Credentials for the first Tier 3 admin, seeded on first run
INITIAL_ADMIN_EMAIL="admin@yourdomain.com"
INITIAL_ADMIN_PASSWORD="secure-password-here"
AUTH_SECRET="replace-with-a-long-random-string"

# Resend API key — used to send team magic-link login emails (Round2.md §7)
# Sign up at https://resend.com (free tier is plenty for 25 emails)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="Equinox <equinox@yourdomain.com>"

# Google Sheets API — used for question pool import (Round2.md §6)
# Create a service account in Google Cloud Console, share the question
# Sheet + Drive folder with its email, and paste the JSON key below
# (as a single-line string) or point to a key file path.
GOOGLE_SERVICE_ACCOUNT_EMAIL="equinox-importer@your-project.iam.gserviceaccount.com"
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID="the-sheet-id-from-its-url"

# Public base URL of the deployed app — used to build magic-link URLs in
# emails. Set to http://localhost:3000 for local dev.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
